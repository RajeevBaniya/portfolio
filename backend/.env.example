# Copy these names into backend/.env (local) and Render > Environment (live).
# Never commit real values.

# Websites allowed to call this backend, comma separated, no trailing slash
ALLOWED_ORIGINS=

# EmailJS (Private Key: EmailJS > Account > API keys)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_CONTACT=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
